OXP_API_KEY=
OXP_MERCHANT_ID=
OXP_WEBHOOK_PASSWORD=

# Local: http://localhost:3000
# Vercel: https://your-app.vercel.app
PUBLIC_APP_URL=http://localhost:3000
CALLBACK_PUBLIC_URL=https://your-webhook-viewer.example

# Neon Postgres (use same value in Vercel Project → Settings → Environment Variables)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
USE_EMBEDDED_POSTGRES=false

PORT=3000
